[Unit]
Description=MobiWave Email Signature Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=milter
Group=milter
WorkingDirectory=/opt/mobiwave-signature-manager/gateway
EnvironmentFile=/etc/mobiwave-signature-gateway.env
ExecStart=/usr/bin/python3 /opt/mobiwave-signature-manager/gateway/signature_gateway.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/milter

[Install]
WantedBy=multi-user.target
